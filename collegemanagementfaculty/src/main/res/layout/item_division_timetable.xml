<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Division Name + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDivisionName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DivisionName"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/card_title" />

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvTimetableStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ Created"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:background="@drawable/badge_green"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <!-- Course + Year + Semester -->
        <TextView
            android:id="@+id/tvCourseInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CourseInfo"
            android:textSize="13sp"
            android:textColor="@color/grey_text"
            android:layout_marginTop="4dp" />

        <!-- Class Teacher -->
        <TextView
            android:id="@+id/tvClassTeacher"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ClassTeacher"
            android:textSize="12sp"
            android:textColor="@color/grey_text"
            android:layout_marginTop="2dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- View/Edit Button -->
            <Button
                android:id="@+id/btnViewTimetable"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="📅 View"
                android:textSize="12sp"
                android:backgroundTint="@color/primary" />

            <!-- Create/Edit Button -->
            <Button
                android:id="@+id/btnCreateTimetable"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="✏️ Create"
                android:textSize="12sp"
                android:backgroundTint="@color/green_dark" />

            <!-- Delete Button -->
            <Button
                android:id="@+id/btnDeleteTimetable"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🗑️ Delete"
                android:textSize="12sp"
                android:backgroundTint="@color/red" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
