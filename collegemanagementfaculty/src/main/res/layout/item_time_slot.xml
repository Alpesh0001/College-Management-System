<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- ✅ Time Column -->
        <LinearLayout
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_time_slot"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvTimeFrom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <View
                android:layout_width="20dp"
                android:layout_height="1dp"
                android:background="@color/primary"
                android:alpha="0.4"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="3dp"/>

            <TextView
                android:id="@+id/tvTimeTo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

        </LinearLayout>

        <!-- ✅ Subject + Faculty Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvSubjectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SubjectName"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1F2937" />

            <TextView
                android:id="@+id/tvFacultyName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FacultyName"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/tvRoomNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room No "
                android:textSize="12sp"
                android:textColor="#9CA3AF"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- ✅ Edit + Delete Buttons Column -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Edit Button -->
            <ImageButton
                android:id="@+id/btnEditSlot"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#1E40AF"
                android:contentDescription="Edit"
                android:layout_marginBottom="4dp"/>

            <!-- Delete Button -->
            <ImageButton
                android:id="@+id/btnDeleteSlot"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#EF4444"
                android:contentDescription="Delete" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
