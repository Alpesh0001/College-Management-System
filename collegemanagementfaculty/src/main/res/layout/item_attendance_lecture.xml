<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardLecture"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    android:backgroundTint="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <View
            android:id="@+id/viewStatusBar"
            android:layout_width="4dp"
            android:layout_height="56dp"
            android:background="#F44336"
            android:layout_marginEnd="12dp" />

        <!-- ✅ Lecture Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSubjectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SubjectName"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#111827" />

            <TextView
                android:id="@+id/tvDivisionInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DivisionInfo"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvTimeSlot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00 AM – 00:00 AM"
                android:textSize="12sp"
                android:textColor="@color/primary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- ✅ Right Side — Status Badge + Arrow -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:orientation="vertical">

            <!-- ✅ Marked Badge -->
            <TextView
                android:id="@+id/tvMarkedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#DCFCE7"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="✅ Marked"
                android:textColor="#16A34A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- ✅ Pending Badge -->
            <TextView
                android:id="@+id/tvPendingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FEE2E2"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="⏳ Pending"
                android:textColor="#DC2626"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- ✅ Arrow Icon → shows card is clickable -->
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="6dp"
                android:alpha="0.4"
                android:src="@drawable/ic_arrow_right" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
