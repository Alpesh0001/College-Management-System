<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_clean_gradient">

    <View
        android:id="@+id/topView"
        android:layout_width="0dp"
        android:layout_height="320dp"
        android:background="@drawable/bg_button_modern"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- ========= HEADER ========= -->
            <FrameLayout
                android:id="@+id/logo_outer_glow"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/logo_background"
                android:backgroundTint="#20FFFFFF">

                <androidx.cardview.widget.CardView
                    android:id="@+id/logo_container"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="45dp"
                    app:cardElevation="10dp"
                    app:cardBackgroundColor="@color/white">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="18dp"
                        android:src="@drawable/logo"
                        android:contentDescription="App Logo"/>
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <TextView
                android:id="@+id/tv_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_gravity="center"
                android:text="Student Portal"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:fontFamily="sans-serif-black"/>

            <TextView
                android:id="@+id/tv_tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Your Smart Campus Companion"
                android:textColor="@color/tagline_white"
                android:textSize="15sp"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"/>

            <!-- ========= LOGIN CARD ========= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/login_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome Back"
                        android:textSize="24sp"
                        android:layout_gravity="start"
                        android:textColor="@color/login_title_text"
                        android:fontFamily="sans-serif-black"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign in to your academic account"
                        android:textSize="15sp"
                        android:layout_gravity="start"
                        android:textColor="@color/login_secondary_text"
                        android:layout_marginBottom="28dp"
                        android:fontFamily="sans-serif-medium"/>

                    <!-- ✅ GR NUMBER FIELD — added tilGrNo ID -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilGrNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Student GR No."
                        app:hintAnimationEnabled="false"
                        app:startIconDrawable="@drawable/ic_user">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etGrNo"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"

                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/textPrimary"
                            android:textColorHint="@color/login_hint_text"
                            android:maxLines="1"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- ✅ PASSWORD FIELD — added tilPassword ID -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Password"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"

                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textColor="@color/textPrimary"
                            android:textColorHint="@color/login_hint_text"
                            android:inputType="textPassword"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tv_forgot_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forgot Password?"
                        android:textColor="@color/login_link_text"
                        android:layout_gravity="end"
                        android:layout_marginTop="14dp"
                        android:textSize="14sp"/>

                    <!-- ✅ ERROR TEXT — newly added -->
                    <TextView
                        android:id="@+id/tv_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text=""
                        android:textSize="13sp"
                        android:gravity="center"
                        android:visibility="gone"
                        android:fontFamily="sans-serif-medium"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_login"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="24dp"
                        android:text="Login"
                        android:textAllCaps="false"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/colorPrimary"
                        app:cornerRadius="18dp"
                        app:elevation="8dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Don't have an account? "
                            android:textColor="@color/login_secondary_text"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/tv_register"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Register"
                            android:textColor="@color/login_link_text"
                            android:textStyle="bold"
                            android:textSize="14sp"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ========= FOOTER ========= -->
            <TextView
                android:id="@+id/tv_version"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="VERSION 1.0.2"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"/>

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="© 2025 Academic Systems"
                android:textColor="@color/colorPrimary"
                android:textSize="12sp"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
