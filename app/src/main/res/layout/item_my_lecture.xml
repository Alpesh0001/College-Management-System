<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- ✅ Time Column -->
        <LinearLayout
            android:layout_width="84dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_time_slot"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvTimeFrom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9:45"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"/>

            <TextView
                android:id="@+id/tvTimeTo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:30"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

        </LinearLayout>

        <!-- ✅ Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <!-- Subject Name -->
            <TextView
                android:id="@+id/tvSubjectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SubjectName"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1F2937" />

            <!-- Subject Code -->
            <TextView
                android:id="@+id/tvSubjectCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SubjectCode"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:layout_marginTop="2dp"/>

            <!-- Division Name -->
            <TextView
                android:id="@+id/tvDivisionName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DivisionName"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:layout_marginTop="3dp"/>

            <!-- Room No -->
            <TextView
                android:id="@+id/tvRoomNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room No"
                android:textSize="12sp"
                android:textColor="#9CA3AF"
                android:layout_marginTop="2dp"/>

        </LinearLayout>

        <!-- ✅ Right: Subject Code Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvSlotType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lecture"
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:background="@drawable/badge_blue_light"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
