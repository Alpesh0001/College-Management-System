# ─────────────────────────────────────────────────────────────────────────────
# COLLEGE MANAGEMENT SYSTEM — LOCAL CONFIGURATION TEMPLATE
# ─────────────────────────────────────────────────────────────────────────────
#
# HOW TO USE:
#   1. Copy this file and rename the copy to:  local.properties
#   2. Fill in your real values below.
#   3. NEVER commit local.properties to Git — it is already in .gitignore.
#   4. After editing, sync Gradle in Android Studio:
#      File → Sync Project with Gradle Files
#
# This file (local.properties.example) is SAFE to commit.
# It contains NO real secrets — only placeholder values.
# ─────────────────────────────────────────────────────────────────────────────

# Android SDK location (set automatically by Android Studio)
sdk.dir=/path/to/your/Android/Sdk

# ── SMTP / Email (Gmail App Password used for OTP sending) ────────────────────
# 1. Enable 2-Step Verification on your Google Account.
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail" → copy the 16-character password.
# Note: Gmail App Passwords look like: "abcd efgh ijkl mnop"
SMTP_SENDER_EMAIL=your_gmail_address@gmail.com
SMTP_SENDER_PASSWORD=your_16_char_gmail_app_password

# ── Razorpay (Payment Gateway) ────────────────────────────────────────────────
# Get your key from: https://dashboard.razorpay.com/app/keys
# Test keys start with: rzp_test_
# Live keys start with: rzp_live_   (use ONLY for production)
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyHere

# ── ImgBB (Image Upload API) ──────────────────────────────────────────────────
# Get your free API key from: https://api.imgbb.com/
# Used for uploading profile pictures (Admin and Faculty modules).
IMGBB_API_KEY=your_imgbb_api_key_here

# ── Cloudinary (PDF / File Upload) ───────────────────────────────────────────
# Get these from your Cloudinary Dashboard: https://cloudinary.com/console
# Used by the Faculty module to upload study materials and assignments.
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
# Upload preset name — create one in Cloudinary Dashboard under Settings → Upload
CLOUDINARY_UPLOAD_PRESET=your_upload_preset_name_here
