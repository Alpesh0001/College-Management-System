<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow -->
    <item>
        <shape>
            <solid android:color="#15000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- White card -->
    <item
        android:left="0dp"
        android:top="2dp"
        android:right="0dp"
        android:bottom="4dp">
        <shape>
            <solid android:color="@android:color/white" />
            <corners android:radius="12dp" />
        </shape>
    </item>

</layer-list>
