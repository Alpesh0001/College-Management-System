<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg_rounded"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- big circle avatar icon -->
    <ImageView
        android:id="@+id/imgSuccessIcon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:contentDescription="Success"
        android:src="@drawable/ic_user_round_blue" />

    <TextView
        android:id="@+id/txtSuccessTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Admin Login..."
        android:textColor="#4060FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtSuccessMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Please wait... you will be redirected."
        android:textColor="#555555"
        android:textSize="13sp" />

    <!-- simple loading circle (can be your own drawable) -->
    <ProgressBar
        android:id="@+id/progressSuccess"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/progress_ring_rotate" />




</LinearLayout>
