<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fitsSystemWindows="true">

    <!-- Top Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:elevation="4dp"
        app:title="Course Details"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollRoot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/detailsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="24dp">

            <!-- Course Information Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/departmenttitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Course Information"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"/>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnEditCourse"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Edit"
                        android:textColor="@color/colorPrimary"
                        android:background="@drawable/bg_button_tonal"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"/>
                </LinearLayout>

                <!-- Course Name -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCourseName"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Course Name"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusTopStart="8dp"
                    app:startIconDrawable="@drawable/ic_course"
                    app:startIconTint="@color/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCourseName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:inputType="textCapWords"
                        android:maxLines="2"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Course Code -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCourseCode"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Course Code"
                    app:boxCornerRadiusBottomEnd="8dp"
                    app:boxCornerRadiusBottomStart="8dp"
                    app:boxCornerRadiusTopEnd="8dp"
                    app:boxCornerRadiusTopStart="8dp"
                    app:startIconDrawable="@drawable/ic_id"
                    app:startIconTint="@color/colorPrimary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCourseCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:enabled="false"
                        android:inputType="textCapCharacters"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Duration and Status Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <!-- Duration -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDuration"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="Duration (Years)"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:startIconDrawable="@drawable/ic_calendar"
                        app:startIconTint="@color/colorPrimary">

                        <AutoCompleteTextView
                            android:id="@+id/etDurationYears"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:inputType="none"
                            android:maxLines="1"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Status -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilStatus"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Status"
                        app:boxCornerRadiusBottomEnd="8dp"
                        app:boxCornerRadiusBottomStart="8dp"
                        app:boxCornerRadiusTopEnd="8dp"
                        app:boxCornerRadiusTopStart="8dp"
                        app:startIconDrawable="@drawable/ic_info"
                        app:startIconTint="@color/colorPrimary">

                        <AutoCompleteTextView
                            android:id="@+id/ddStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:enabled="false"
                            android:inputType="none"
                            android:maxLines="1"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Save Button (Hidden in View Mode) -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSaveCourse"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="Save Changes"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_button_primary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- Semester Fees Card -->
            <LinearLayout
                android:id="@+id/cardSemFees"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Semester Fees"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnEditFees"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Edit Fees"
                        android:textColor="@color/colorPrimary"
                        android:background="@drawable/bg_button_tonal"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- View Mode: Fees List -->
                <LinearLayout
                    android:id="@+id/containerFeesView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Edit Mode: Fees Inputs -->
                <LinearLayout
                    android:id="@+id/containerFeesEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Save Fees Button (Edit Mode only) -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSaveFees"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:text="Save Fees"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_button_primary"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:visibility="gone" />

            </LinearLayout>


            <!-- Subjects Section Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Subjects"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvSubjectCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 subjects in this course"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="16dp"/>

                <!-- Manage Subjects Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnManageSubjects"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="📚 Manage Subjects"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_button_primary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textAllCaps="false"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View, add, edit, and delete subjects for this course"
                    android:textSize="12sp"
                    android:textColor="#9CA3AF"
                    android:layout_marginTop="8dp"
                    android:gravity="center"/>

            </LinearLayout>

            <!-- Danger Zone Card -->
            <LinearLayout
                android:id="@+id/dangerZoneCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_danger"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Danger Zone"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#DC2626"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deleting this course will also delete all associated subjects. This action cannot be undone."
                    android:textSize="13sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="16dp"/>

                <!-- Delete Course Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDeleteCourse"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="🗑️ Delete Course"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_button_danger"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textAllCaps="false"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Loading Overlay -->
    <ProgressBar
        android:id="@+id/progressOverlay"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
