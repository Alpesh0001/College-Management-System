<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name=".utils.App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CollegeManagementSystemAdmin">
        <activity
            android:name=".FeesManagementActivity"
            android:exported="false" />
        <activity
            android:name=".TestDataActivity"
            android:exported="false" />
        <activity
            android:name=".AdminAddDivisionActivity"
            android:exported="false" />
        <activity
            android:name=".AdminDivisionActivity"
            android:exported="false" />
        <activity
            android:name=".AdminFacultyActivity"
            android:exported="false" />
        <activity
            android:name=".AdminAddFacultyActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".AdminAddSubjectActivity"
            android:exported="false" />
        <activity
            android:name=".AdminSubjectsActivity"
            android:exported="false" />
        <activity
            android:name=".AdminCourseDetailsActivity"
            android:exported="false" />
        <activity
            android:name=".AdminAddCourseActivity"
            android:exported="false" />
        <activity
            android:name=".AdminCourseActivity"
            android:exported="false" />
        <activity
            android:name=".AdminStudentsActivity"
            android:exported="false" />
        <activity
            android:name=".AdminAddStudentActivity"
            android:exported="false" />
        <activity
            android:name=".StudentActivity"
            android:exported="false" />
        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".NextActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:fitsSystemWindows="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
    </application>

</manifest>